	#Range: 0 ~ 1440
	dragonRoostsDelayMinutes = 12

#DreamShift: chests in the dream locations a player slips into during a game
[dreamshift]
	#Fewest chests placed near the player when they arrive in a dream location.
	#Range: 0 ~ 10
	chestsMin = 1
	#Most chests placed near the player when they arrive in a dream location.
	#Range: 0 ~ 10
	chestsMax = 2
	#Chance that a dream chest uses a rare loot table (treasure, boss, vault...); otherwise it gets weapons/armor.
	#Range: 0.0 ~ 1.0
	rareTableChance = 0.35
	#A weapon/armor dream chest is rerolled up to this many times until it holds a weapon or armor piece.
	#Range: 1 ~ 50
	gearRolls = 5

[airdrop]
	#Every N minutes of a game a chest with very good loot drops at a random spot inside the zone; it is shown on the map (0 = off).
	#Range: 0 ~ 120
	intervalMinutes = 6

[reveal]
	#Experience levels a living player pays (map screen button) to see where the other players are (0 = free).
	#Range: 0 ~ 100
	costLevels = 2
	#How long the other players stay visible on the map after paying.
	#Range: 1 ~ 600
	showSeconds = 20
