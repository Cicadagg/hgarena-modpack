	#Range: 8 ~ 500
	largeSize = 35
	#Dragon nests (configured features). One random type per nest.
	dragonRoosts = ["iceandfire:fire_dragon_roost", "iceandfire:ice_dragon_roost", "iceandfire:lightning_dragon_roost"]
	#Minimum dragon nests per game.
	#Range: 0 ~ 10
	dragonRoostsMin = 1
	#Maximum dragon nests per game.
	#Range: 0 ~ 10
	dragonRoostsMax = 2
	#Locations are at least this far from the arena center.
	#Range: 0 ~ 5000
	minDistanceFromCenter = 60
	#Minimum gap in blocks between two locations.
	#Range: 0 ~ 200
	gap = 32
	#Ground under a location may differ in height by at most this many blocks.
