		spellResourceKeywords = []

[game]
	#How far from the arena edge the lobby platform is built (blocks, to the south).
	#Range: 16 ~ 5000
	lobbyDistanceFromEdge = 80
	#Y level of the lobby platform floor.
	#Range: -60 ~ 310
	lobbyY = 150
	#Countdown after the start button is pressed.
	#Range: 0 ~ 60
	countdownSeconds = 5
	#Players start on a circle of this radius around the center (grows if many players).
	#Range: 3 ~ 1000
	playerRingRadius = 30
	#Start chests are placed on a circle of this radius, evenly between the players.
	#Range: 2 ~ 1000
	chestRingRadius = 20
	#How many extra start chests per player on the ring between players (0 = none).
	#Range: 0 ~ 20
	chestsPerPlayer = 0
	#Seconds between the victory and the return to the lobby.
	#Range: 1 ~ 120
	endSeconds = 10
	#How many chunks are restored per tick after a game (higher = faster, more lag).
	#Range: 1 ~ 256
	restoreChunksPerTick = 8
	#Inscription tables (Iron's Spells) placed near the arena center each game, to put spells from scrolls into spell books (0 = none).
	#Range: 0 ~ 16
	inscriptionTables = 0
	#Distance of the inscription tables from the arena center.
	#Range: 2 ~ 1000
	inscriptionTableRadius = 12
	#Block used as the inscription table.
	inscriptionTableBlock = "irons_spellbooks:inscription_table"

[zone]
	#Starting zone (world border) size in blocks. 0 = arena diameter + 10.
	#Range: 0 ~ 100000
	startSize = 0
	#The zone never gets smaller than this.
	#Range: 1 ~ 100000
	minSize = 20
	#Each shrink multiplies the zone size by this.
	#Range: 0.05 ~ 0.99
	shrinkFactor = 0.6
	#The zone shrinks every N minutes.
	#Range: 1 ~ 1440
	shrinkIntervalMinutes = 9
	#How long one shrink takes.
	#Range: 1 ~ 3600
	shrinkDurationSeconds = 90
	#Damage per second per block outside the zone.
	#Range: 0.0 ~ 100.0
	damagePerBlock = 1.0

[spawnChests]
	#Chests of the map within this distance of the center are locked spawn chests.
	#Range: 0 ~ 1000
	radius = 20
	#Experience levels a player pays to unlock a spawn chest (0 = not locked). Spawn chests are filled once at game start and never refilled; once paid, a chest stays open for everyone until the game ends.
	#Range: 0 ~ 1000
	requiredLevel = 10
	#Chance that a spawn chest uses a weapon/armor loot table.
	#Range: 0.0 ~ 1.0
	combatTableChance = 0.85
	#A spawn chest is rerolled up to this many times until it holds a weapon or armor piece.
	#Range: 1 ~ 50
	gearRolls = 5
	#Loot tables whose id contains one of these words count as weapon/armor tables.
	combatKeywords = ["weapon", "armor", "armour", "armory", "armoury", "smith", "barracks", "arsenal", "knight", "warrior", "soldier", "military", "outpost", "fortress", "nether_bridge", "bastion", "tower", "dungeon", "castle", "citadel", "guard", "battle", "forge", "keep"]

[locations]
	#Structures from mods that may appear as locations. Every game a few of them are picked at random and fitted onto flat ground.
	structures = ["soulsweapons:champions_graves", "block_factorys_bosses:dragon_tower", "valarian_conquest:bandit_camp", "valarian_conquest:bandit_ruins", "valarian_conquest:valarian_outpost", "takesapillage:pillager_camp", "i_wanna_travel:structure_1fontaine", "i_wanna_travel:structure_20ruinetour", "ancient_remnants:oakwood_monument", "ancient_remnants:warrior_monolith", "craft_of_the_wild:stables"]
