[chests]
	#Every N minutes all arena chests get new random loot and a new wave of random chests appears. 0 = only by command.
	#Range: 0 ~ 1440
	refillIntervalMinutes = 10
	#How many extra chests appear at random places in each refill wave (0 = only the grid chests).
	#Range: 0 ~ 500
	randomChestsPerWave = 0
	#Maximum extra random chests at once; the oldest ones disappear first (grid chests are not counted).
	#Range: 0 ~ 2000
	maxRandomChests = 200
	#Also use every 'chests/...' loot table from all installed mods.
	useAllChestLootTables = true
	#Loot tables always available for arena chests.
	lootTables = ["minecraft:chests/simple_dungeon", "minecraft:chests/abandoned_mineshaft", "minecraft:chests/desert_pyramid", "minecraft:chests/jungle_temple", "minecraft:chests/village/village_weaponsmith", "minecraft:chests/village/village_armorer", "minecraft:chests/village/village_toolsmith", "minecraft:chests/shipwreck_supply", "minecraft:chests/pillager_outpost", "minecraft:chests/ruined_portal", "minecraft:chests/stronghold_corridor", "minecraft:chests/igloo_chest"]
	#Loot tables (or prefixes ending with *) that are never used.
	excludedLootTables = []
	#At game start chests are placed over the whole arena on a grid with this spacing in blocks.
	#Range: 8 ~ 1000
	gridSpacing = 40
	#No grid chests closer than this to the arena center (keeps the spawn area free).
	#Range: 0 ~ 5000
	gridMinDistanceFromCenter = 45
	#Chance that a grid chest uses a rare loot table (treasure, boss, vault and so on).
	#Range: 0.0 ~ 1.0
	rareTableChance = 0.05
	#Loot tables whose id contains one of these words count as rare.
	rareKeywords = ["treasure", "boss", "vault", "end_city", "ancient", "bastion", "legendary", "epic", "relic", "hoard", "mythic", "artifact", "citadel"]
	#Chance that an ordinary arena chest is filled from a weapon/armor loot table and rerolled until it holds gear.
	#Range: 0.0 ~ 1.0
	gearChestChance = 0.5
	#How many times such a chest is rerolled until it holds a weapon or armor piece.
	#Range: 1 ~ 50
	gearChestRolls = 3

	#Iron's Spells & Spellbooks (only when the mod is installed)
	[chests.spells]
		#Chance that an arena chest gets a ready spell scroll or a spell book with spells.
		#Range: 0.0 ~ 1.0
		spellChestChance = 0.3
		#Of those, the chance that it is a spell book (otherwise a scroll).
		#Range: 0.0 ~ 1.0
		spellBookChance = 0.3
		#Fewest spells inscribed in a spell book.
		#Range: 1 ~ 20
		spellBookMinSpells = 2
		#Most spells inscribed in a spell book (never more than its slots).
